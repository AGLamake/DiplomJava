<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ru.vlsu.security.ui.MainController">
    <top>
        <HBox styleClass="header" spacing="12" alignment="CENTER_LEFT">
            <Label text="Главное меню" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel"/>
            <Button text="О программе" onAction="#onAbout"/>
            <Button text="Выход" onAction="#onLogout"/>
        </HBox>
    </top>
    <left>
        <VBox fx:id="menu" styleClass="sidebar"/>
    </left>
    <center>
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>
